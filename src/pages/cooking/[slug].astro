---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryLayout from '../../components/EntryLayout.astro';
import Frame from '../../components/Frame.astro';
import { embeds } from '../../components/embeds';
import { getRecipes, type Recipe } from '../../lib/content';
import { neighbours } from '../../lib/entries';
import { formatDate } from '../../lib/dates';
import { routes } from '../../lib/paths';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe, i) => ({
    params: { slug: recipe.id },
    props: { recipe, ...neighbours(recipes, i) },
  }));
}

interface Props {
  recipe: Recipe;
  older?: Recipe;
  newer?: Recipe;
}

const { recipe, older, newer } = Astro.props;
const { Content } = await render(recipe);
const r = recipe.data;
const link = (e?: Recipe) => e && { title: e.data.title, href: routes.recipe(e.id) };

const meta = [
  { label: 'cooked', value: formatDate(r.date) },
  { label: 'from', value: r.source_name, href: r.source_url, external: true },
  r.challenge
    ? { label: 'country', value: r.country, href: routes.challenge }
    : { label: 'country', value: r.country },
  { label: 'time', value: r.time },
  { label: 'serves', value: r.serves },
  { label: 'again?', value: r.again },
];
---

<Base title={r.title} description={r.lead} current="cooking" article>
  <EntryLayout
    label="cooking"
    meta={meta}
    title={r.title}
    lead={r.lead}
    older={link(older)}
    newer={link(newer)}
  >
    <Frame slot="media" src={r.image} alt={r.title} ratio="4 / 3" tone={2} />
    <Content components={embeds} />
  </EntryLayout>
</Base>
