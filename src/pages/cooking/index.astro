---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Frame from '../../components/Frame.astro';
import MiniMap from '../../components/MiniMap.astro';
import { getRecipes, cookedCount } from '../../lib/content';
import { formatDate } from '../../lib/dates';

const recipes = await getRecipes();
const cooked = cookedCount(recipes);
---

<Base title="What I've been cooking" current="cooking">
  <PageIntro label="cooking" title="What I've been cooking" text="Recipes I followed, with what I changed." />

  <section class="challenge kraft-band grid-12" aria-labelledby="challenge-title">
    <div class="intro span-5">
      <p class="mono accent">around the world</p>
      <h2 id="challenge-title">One national dish per country</h2>
      <p class="muted">{cooked} of 195 cooked</p>
      <a class="mono" href="/cooking/around-the-world">the challenge →</a>
    </div>
    <div class="span-7">
      <MiniMap />
    </div>
  </section>

  <ul class="recipes">
    {recipes.map((recipe, i) => (
      <li>
        <a class="card" href={`/cooking/${recipe.id}`}>
          <Frame src={recipe.data.image} alt={recipe.data.title} ratio="4 / 3" tone={((i % 3) + 1) as 1 | 2 | 3} />
          <span class="text">
            <span class="mono muted">{formatDate(recipe.data.date)} · {recipe.data.country}</span>
            <span class="title">{recipe.data.title}</span>
            <span class="source muted">from {recipe.data.source_name}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .challenge {
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: 40px;
    line-height: 1.25;
  }
  .intro a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .recipes {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
  }
  .source {
    font-size: 14px;
  }
</style>
