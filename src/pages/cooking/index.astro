---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Frame from '../../components/Frame.astro';
import MiniMap from '../../components/map/MiniMap.astro';
import { getRecipes, emptyNotes } from '../../lib/content';
import { getCooked } from '../../lib/challenge';
import { COUNTRY_TOTAL } from '../../lib/countries';
import { routes } from '../../lib/paths';
import { formatDate } from '../../lib/dates';
import { placeholderTone } from '../../lib/placeholder';

const recipes = await getRecipes();
const cooked = (await getCooked()).size;
---

<Base title="What I've been cooking" current="cooking">
  <PageIntro
    label="cooking"
    title="What I've been cooking"
    text="Recipes I followed, with what I changed."
  />

  <section class="challenge kraft-band grid-12" aria-labelledby="challenge-title">
    <div class="intro span-5">
      <p class="mono accent">around the world</p>
      <h2 id="challenge-title">One national dish per country</h2>
      <p class="muted">
        {cooked} of {COUNTRY_TOTAL} cooked
      </p>
      <a class="mono" href={routes.challenge}>
        the challenge →
      </a>
    </div>
    <div class="span-7">
      <MiniMap ground="kraft" />
    </div>
  </section>

  {recipes.length === 0 ? (
    <p class="empty empty-note">{emptyNotes.cooking}</p>
  ) : (
    <ul class="recipes">
      {recipes.map((recipe, i) => (
        <li>
          <a class="card" href={routes.recipe(recipe.id)}>
            <Frame
              src={recipe.data.image}
              alt={recipe.data.title}
              ratio="4 / 3"
              tone={placeholderTone(i)}
            />
            <span class="text">
              <span class="mono muted">
                {formatDate(recipe.data.date)} · {recipe.data.country}
              </span>
              <span class="title">{recipe.data.title}</span>
              <span class="source muted">from {recipe.data.source_name}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .challenge {
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: 40px;
    line-height: 1.25;
  }
  .intro a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .empty {
    margin-top: 64px;
  }
  .recipes {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
  }
  .source {
    font-size: 14px;
  }
</style>
