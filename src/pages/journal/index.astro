---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getJournal, emptyNotes } from '../../lib/content';
import { routes } from '../../lib/paths';
import { formatDate } from '../../lib/dates';

const entries = await getJournal();
---

<Base title="Notes & essays" current="journal">
  <PageIntro label="journal" title="Notes & essays" />
  {entries.length === 0 ? (
    <p class="empty empty-note">{emptyNotes.journal}</p>
  ) : (
    <ul>
      {entries.map((entry) => (
        <li>
          <a class="row" href={routes.journalEntry(entry.id)}>
            <span class="mono muted">{formatDate(entry.data.date)}</span>
            <span class="text">
              <span class="title">{entry.data.title}</span>
              <span class="summary muted">{entry.data.summary}</span>
            </span>
            <span class="tags mono muted">{entry.data.tags.join(', ')}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .empty {
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
  }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr 200px;
    align-items: baseline;
    column-gap: 32px;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.3;
  }
  .summary {
    font-size: 16px;
  }
  .tags {
    text-align: right;
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 8px;
      padding: 20px 0;
    }
    .title {
      font-size: 22px;
    }
    .summary {
      font-size: 15px;
    }
    .tags {
      text-align: left;
    }
  }
</style>
