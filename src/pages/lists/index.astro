---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getLists, emptyNotes } from '../../lib/content';
import { routes } from '../../lib/paths';

const lists = await getLists();
---

<Base
  title="Lists"
  description="A yearly look back: ten songs, ten albums, ten films, ten books."
  current="lists"
>
  <PageIntro
    label="lists"
    title="Top tens, every December"
    text="A yearly look back: ten songs, ten albums, ten films, ten books."
  />
  {lists.length === 0 ? (
    <p class="empty empty-note">{emptyNotes.lists}</p>
  ) : (
    <ul>
      {lists.map((list) => (
        <li>
          <a class="row" href={routes.listYear(list.id)}>
            {list.id}, in tens
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .empty {
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
  }
  .row {
    display: block;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.3;
  }
</style>
