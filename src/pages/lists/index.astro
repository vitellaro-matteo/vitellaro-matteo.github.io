---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getLists } from '../../lib/content';

const lists = await getLists();
---

<Base title="Lists" current="lists">
  <PageIntro
    label="lists"
    title="Top tens, every December"
    text="A yearly look back: ten songs, ten albums, ten films, ten books."
  />
  <ul>
    {lists.map((list) => (
      <li>
        <a class="row" href={`/lists/${list.id}`}>{list.id}, in tens</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .row {
    display: block;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.3;
  }
</style>
