---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Frame from '../../components/Frame.astro';
import { getLists, type List } from '../../lib/content';
import { routes } from '../../lib/paths';
import { placeholderTone } from '../../lib/placeholder';

export async function getStaticPaths() {
  return (await getLists()).map((list) => ({ params: { year: list.id }, props: { list } }));
}

interface Props {
  list: List;
}

const { list } = Astro.props;
const year = list.id;
const categories = ['songs', 'albums', 'films', 'books'] as const;
const square = (cat: string) => cat === 'songs' || cat === 'albums';
---

<Base title={`${year}, in tens`} current="lists">
  <PageIntro
    label="lists"
    title={`${year}, in tens`}
    text="Written in December. Ten of each, in order, with a line on why each one stayed."
  />

  <div class="tabs" role="tablist" aria-label="Categories">
    {categories.map((cat, i) => (
      <a
        class="tab"
        role="tab"
        id={`tab-${cat}`}
        href={`#${cat}`}
        aria-controls={cat}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {cat}
      </a>
    ))}
  </div>

  {categories.map((cat) => (
    <section class="panel" id={cat} role="tabpanel" aria-labelledby={`tab-${cat}`}>
      <ol>
        {list.data[cat].map((item, i) => (
          <li class="row">
            <span class:list={['numeral', { first: i === 0 }]}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <Frame
              src={item.image}
              alt={`${item.title} — ${item.creator}`}
              ratio={square(cat) ? '1 / 1' : '2 / 3'}
              tone={placeholderTone(i)}
            />
            <div class="text">
              <p class="title">{item.title}</p>
              <p class="creator muted">{item.creator}</p>
            </div>
            <p class="note muted">{item.note}</p>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <p class="archive">
    <a class="mono" href={routes.lists}>
      archive: earlier years →
    </a>
  </p>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));
  const names = panels.map((p) => p.id);

  function show(name: string) {
    if (!names.includes(name)) name = names[0];
    tabs.forEach((t) =>
      t.setAttribute('aria-selected', String(t.getAttribute('aria-controls') === name)),
    );
    panels.forEach((p) => (p.hidden = p.id !== name));
  }

  tabs.forEach((tab) =>
    tab.addEventListener('click', (event) => {
      event.preventDefault();
      const name = tab.hash.slice(1);
      history.replaceState(null, '', `#${name}`);
      show(name);
    }),
  );
  window.addEventListener('hashchange', () => show(location.hash.slice(1)));
  show(location.hash.slice(1));
</script>

<style>
  .tabs {
    display: flex;
    gap: 36px;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    display: flex;
    align-items: center;
    height: 48px;
    font-size: 16px;
    color: var(--muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .tab:hover {
    color: var(--accent);
  }
  .row {
    display: grid;
    grid-template-columns: 120px 104px 1fr 300px;
    column-gap: 32px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .numeral {
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--numeral);
  }
  .numeral.first {
    color: var(--accent);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.3;
  }
  .creator {
    font-size: 15px;
  }
  .note {
    font-size: 15px;
    line-height: 1.6;
  }
  .archive {
    margin-top: 40px;
    display: flex;
    justify-content: flex-end;
  }
  .archive a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  /* Below desktop the note moves under the title. */
  @media (max-width: 1023px) {
    .row {
      grid-template-columns: 72px 104px minmax(0, 1fr);
      grid-template-areas:
        'numeral image text'
        'numeral image note';
      row-gap: 12px;
    }
    .numeral {
      grid-area: numeral;
      font-size: 48px;
    }
    .row > :global(.frame) {
      grid-area: image;
    }
    .text {
      grid-area: text;
    }
    .note {
      grid-area: note;
    }
  }

  @media (max-width: 767px) {
    .tabs {
      gap: 24px;
    }
    .row {
      grid-template-columns: 48px 72px minmax(0, 1fr);
      column-gap: 16px;
      padding: 20px 0;
    }
    .numeral {
      font-size: 32px;
    }
    .title {
      font-size: 20px;
    }
    .archive {
      justify-content: flex-start;
    }
  }
</style>
