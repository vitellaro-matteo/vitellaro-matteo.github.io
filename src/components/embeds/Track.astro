---
// <Track id="…" /> — looks the track up in the Spotify feed by id: the playlist,
// then the embedded tracks the fetcher adds. Explicit title/artist/cover props
// override the feed.
import EmbedCard from './EmbedCard.astro';
import { spotify } from '../../lib/feeds';

interface Props {
  id: string;
  label?: string;
  title?: string;
  artist?: string;
  cover?: string;
}

const { id, label = "from last week's finds", ...given } = Astro.props;
const found = [...(spotify?.tracks ?? []), ...(spotify?.embedded ?? [])].find((t) => t.id === id);
const title = given.title ?? found?.title;
const artist = given.artist ?? found?.artists.join(', ');

// With a feed, an unknown id is an authoring mistake and should stop the build.
// Without one (the fetch failed and nothing was cached), the embed is left out,
// like the home-page card, so one outage can't block a deploy.
if (!(title && artist) && spotify) {
  throw new Error(
    `<Track id="${id}"/>: track not found in the Spotify feed. ` +
      `Pass title="…" and artist="…" (and optionally cover="/media/…") directly.`,
  );
}
if (!(title && artist)) {
  console.warn(`[feeds] no spotify feed: leaving out <Track id="${id}"/>`);
}
---

{title && artist && (
  <EmbedCard
    label={label}
    title={title}
    subtitle={artist}
    image={given.cover ?? found?.cover}
    imageAlt={`Cover art for ${title}`}
    imageHeight={96}
    linkText="listen"
    href={found?.url ?? `https://open.spotify.com/track/${id}`}
  />
)}
