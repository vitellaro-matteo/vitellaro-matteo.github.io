---
import { site } from '../../site.config';
import { routes } from '../lib/paths';

interface Props {
  current?: string;
}

const { current } = Astro.props;

// The first six are sections of the home page; journal and lists are pages of their own.
const nav = [
  { key: 'listening', href: `${routes.home}#listening` },
  { key: 'watching', href: `${routes.home}#watching` },
  { key: 'reading', href: `${routes.home}#reading` },
  { key: 'seeing', href: `${routes.home}#seeing` },
  { key: 'making', href: `${routes.home}#making` },
  { key: 'cooking', href: `${routes.home}#cooking` },
  { key: 'journal', href: routes.journal },
  { key: 'lists', href: routes.lists },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={routes.home}>
      <span class="wordmark display">{site.name}</span>
      <span class="tagline mono muted">{site.tagline}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ current: item.key === current }}
              aria-current={item.key === current ? 'page' : undefined}
            >
              {item.key}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .inner {
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .wordmark {
    font-size: 28px;
    line-height: 1;
  }
  .brand:hover .tagline {
    color: var(--accent);
  }
  nav ul {
    display: flex;
    gap: 30px;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
  }
  nav a.current {
    color: var(--accent);
  }
</style>
