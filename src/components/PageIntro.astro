---
// Page intro in the lists-page style — docs/DESIGN.md §4.4.
interface Props {
  label: string;
  title: string;
  /** Right-hand text; pages with richer content use the `right` slot instead. */
  text?: string;
}

const { label, title, text } = Astro.props;
---

<div class="page-intro">
  <div class="left">
    <p class="mono accent">{label}</p>
    <h1>{title}</h1>
  </div>
  {Astro.slots.has('right') ? (
    <div>
      <slot name="right" />
    </div>
  ) : (
    text && <p class="text muted">{text}</p>
  )}
</div>

<style>
  .page-intro {
    padding: 112px 0 64px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: 72px;
    line-height: 1.1;
  }
  .text {
    font-size: 16px;
    line-height: 1.7;
    max-width: 360px;
  }
</style>
