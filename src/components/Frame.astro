---
// The kraft background shows while the image loads, and stands in for it when src is null.
// Content images (imported through a collection's image() field) are optimised by
// astro:assets: AVIF and WebP at several widths, with width and height set so the
// page never jumps. Feed images and embed images are plain paths under public/.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { fixedImage, type ImageSizes } from '../lib/images';
import { url } from '../lib/paths';
import type { PlaceholderTone } from '../lib/placeholder';

interface Props {
  src: string | ImageMetadata | null | undefined;
  alt: string;
  /** CSS aspect-ratio, e.g. `2 / 3` */
  ratio?: string;
  width?: number;
  height?: number;
  /** Widths and `sizes` for a content image that isn't a fixed width (src/lib/images.ts). */
  sizes?: ImageSizes;
  /** 1 = --kraft, 2 = --kraft-2, 3 = --kraft-3 */
  tone?: PlaceholderTone;
  class?: string;
}

const { src, alt, ratio, width, height, sizes, tone = 1, class: className } = Astro.props;
const style = [
  ratio && `aspect-ratio: ${ratio}`,
  width && `width: ${width}px`,
  height && `height: ${height}px`,
]
  .filter(Boolean)
  .join('; ');
const responsive = sizes ?? (width ? fixedImage(width) : undefined);
// Never upscale: only widths the original has, or just the original.
const fitting =
  typeof src === 'object' && src && responsive
    ? responsive.widths.filter((w) => w <= src.width)
    : [];
---

<div class:list={['frame', tone > 1 && `tone-${tone}`, className]} style={style || undefined}>
  {typeof src === 'string' ? (
    <img src={url(src)} alt={alt} loading="lazy" decoding="async" />
  ) : (
    src && (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={fitting.length > 0 ? fitting : [src.width]}
        sizes={responsive?.sizes ?? `${src.width}px`}
        loading="lazy"
        decoding="async"
      />
    )
  )}
</div>
