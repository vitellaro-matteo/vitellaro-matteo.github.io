---
interface Props {
  title: string;
  meta?: string;
  id?: string;
}

const { title, meta, id } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {meta && <p class="mono muted">{meta}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 40px;
  }
  h2 {
    font-size: 32px;
  }
</style>
