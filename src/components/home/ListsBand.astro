---
// Phase 1 placeholder — YEAR comes from the latest src/content/lists/YEAR.yaml in Phase 2.
import placeholder from '../../data/placeholder/home.json';

const year = placeholder.lists_year;
const categories = ['songs', 'albums', 'films', 'books'];
---

<section class="lists kraft-band grid-12" aria-labelledby="lists-title">
  <div class="intro span-5">
    <p class="mono accent">08 — lists</p>
    <h2 id="lists-title">Top tens, every December</h2>
    <p class="muted">A yearly look back: ten songs, ten albums, ten films, ten books.</p>
  </div>
  <ul class="tiles span-7">
    {categories.map((cat) => (
      <li>
        <a class="tile" href={`/lists/${year}#${cat}`}>
          <span class="ten">10</span>
          <span class="label muted">{cat} of {year}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .lists {
    margin-top: 96px;
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: 40px;
    line-height: 1.25;
  }
  .intro .muted {
    font-size: 16px;
    line-height: 1.7;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .tiles li {
    display: flex;
  }
  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--card);
    padding: 24px 20px;
  }
  .ten {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1;
  }
  .label {
    font-size: 14px;
  }
</style>
