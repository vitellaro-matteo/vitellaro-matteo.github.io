---
import { latestListYear, emptyNotes } from '../../lib/content';
import { routes } from '../../lib/paths';

const year = await latestListYear();
const categories = ['songs', 'albums', 'films', 'books'];
---

<section class="lists kraft-band grid-12" aria-labelledby="lists-title">
  <div class="intro span-5">
    <p class="mono accent">07 — lists</p>
    <h2 id="lists-title">Top tens, every December</h2>
    <p class="muted">A yearly look back: ten songs, ten albums, ten films, ten books.</p>
  </div>
  {year ? (
    <ul class="tiles span-7">
      {categories.map((cat) => (
        <li>
          <a class="tile" href={`${routes.listYear(year)}#${cat}`}>
            <span class="ten">10</span>
            <span class="label muted">
              {cat} of {year}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-note span-7">{emptyNotes.lists}</p>
  )}
</section>

<style>
  .lists {
    margin-top: 96px;
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: 40px;
    line-height: 1.25;
  }
  .intro .muted {
    font-size: 16px;
    line-height: 1.7;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .tiles li {
    display: flex;
  }
  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--card);
    padding: 24px 20px;
  }
  .ten {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1;
  }
  .label {
    font-size: 14px;
  }

  @media (max-width: 1023px) {
    .lists {
      row-gap: 32px;
    }
  }

  @media (max-width: 767px) {
    h2 {
      font-size: 26px;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
