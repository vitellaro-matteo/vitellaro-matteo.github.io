---
import { site } from '../../../site.config';
import { goodreads, lastfm } from '../../lib/feeds';
import { nowBox } from '../../lib/now';
import { formatDate } from '../../lib/dates';
import Frame from '../Frame.astro';
import PreviewButton from '../PreviewButton.astro';

const box = nowBox(lastfm, goodreads);
---

<section class="hero grid-12">
  <div class:list={['intro', box ? 'span-8' : 'span-12']}>
    <p class="mono accent">hello</p>
    <h1>{site.heroTitle}</h1>
    <p class="bio muted">{site.heroBio}</p>
  </div>
  {box && (
    <aside class="now span-4" aria-label="Now">
      <p class="mono muted">now</p>
      <dl>
        {box.rows.map((row) =>
          row.kind === 'artist' ? (
            <div class="row artist">
              <dt class="muted">{row.label}</dt>
              <dd>
                <Frame src={row.image} alt="" width={48} height={48} tone={2} />
                <span class="stack">
                  <span>{row.name}</span>
                  <span class="mono muted">{row.plays}</span>
                </span>
              </dd>
            </div>
          ) : (
            <div class="row" data-preview-row>
              <dt class="muted">{row.label}</dt>
              <dd>
                <span class="value">{row.value}</span>
                {row.deezerId && row.previewLabel && (
                  <PreviewButton deezerId={row.deezerId} label={row.previewLabel} />
                )}
              </dd>
            </div>
          ),
        )}
      </dl>
      <p class="updated mono muted">updated {formatDate(box.updated)}</p>
    </aside>
  )}
</section>

<style>
  .hero {
    padding: 128px 0 120px;
    align-items: end;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  h1 {
    font-size: 56px;
    line-height: 1.28;
  }
  .bio {
    font-size: 18px;
    line-height: 1.7;
    max-width: 580px;
  }
  .now {
    background: var(--kraft);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  dl {
    display: contents;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
  }
  dt {
    white-space: nowrap;
  }
  dd {
    margin: 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    text-align: right;
  }
  .value {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* The photo, name and play count only fit beside the label in a wide box;
     otherwise they wrap under it, still right-aligned, rather than squeezing. */
  .artist {
    align-items: center;
    flex-wrap: wrap;
    row-gap: 8px;
  }
  .artist dd {
    gap: 12px;
    margin-left: auto;
  }
  .artist dd > :global(.frame) {
    flex-shrink: 0;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .stack .mono {
    white-space: nowrap;
  }
  .updated {
    padding-top: 14px;
    border-top: 1px solid var(--kraft-3);
  }

  /* Tablet: the now box moves under the hero text. */
  @media (max-width: 1023px) {
    .hero {
      padding: 96px 0 88px;
      row-gap: 40px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding: 56px 0 48px;
      row-gap: 32px;
    }
    .intro {
      gap: 20px;
    }
    h1 {
      font-size: 32px;
      line-height: 1.35;
    }
    .bio {
      font-size: 16px;
    }
    .now {
      padding: 24px;
    }
  }
</style>
