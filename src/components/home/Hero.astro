---
import { site } from '../../../site.config';
import { now } from '../../lib/data';
import { formatDate } from '../../lib/dates';

const rows = [
  { label: 'on repeat', value: now.on_repeat },
  { label: 'reading', value: now.reading },
  { label: 'thinking about', value: now.thinking_about },
];
---

<section class="hero grid-12">
  <div class="intro span-8">
    <p class="mono accent">hello</p>
    <h1>{site.heroTitle}</h1>
    <p class="bio muted">{site.heroBio}</p>
  </div>
  <aside class="now span-4" aria-label="Now">
    <p class="mono muted">now</p>
    <dl>
      {rows.map((row) => (
        <div class="row">
          <dt class="muted">{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
    {now.updated && <p class="updated mono muted">updated {formatDate(now.updated)}</p>}
  </aside>
</section>

<style>
  .hero {
    padding: 128px 0 120px;
    align-items: end;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  h1 {
    font-size: 56px;
    line-height: 1.28;
  }
  .bio {
    font-size: 18px;
    line-height: 1.7;
    max-width: 580px;
  }
  .now {
    background: var(--kraft);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  dl {
    display: contents;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
  }
  dt {
    white-space: nowrap;
  }
  dd {
    margin: 0;
    text-align: right;
  }
  .updated {
    padding-top: 14px;
    border-top: 1px solid var(--kraft-3);
  }
</style>
