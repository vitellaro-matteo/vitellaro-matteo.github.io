---
import Card from '../Card.astro';
import Frame from '../Frame.astro';
import { goodreads, now } from '../../lib/data';
import { links } from '../../../site.config';

const book = goodreads.currently_reading[0];
const finished = goodreads.read.slice(0, 2);
const progress = now.progress;
const pct = progress ? Math.min(100, Math.max(0, (progress.page / progress.of) * 100)) : 0;
---

<Card id="reading" class="span-5" label="03 — reading" title="on the nightstand" linkText="goodreads" href={links.goodreads}>
  {book && (
    <div class="current">
      <Frame src={book.cover} alt={`Cover of ${book.title}`} width={120} height={180} tone={2} class="cover" />
      <div class="stack">
        <p class="title">{book.title}</p>
        <p class="author muted">{book.author}</p>
        {progress && (
          <>
            <div class="bar" role="progressbar" aria-label="Reading progress" aria-valuemin={0} aria-valuemax={progress.of} aria-valuenow={progress.page}>
              <div class="fill" style={`width: ${pct}%`} />
            </div>
            <p class="mono muted">page {progress.page} of {progress.of}</p>
          </>
        )}
      </div>
    </div>
  )}
  {finished.length > 0 && (
    <div class="finished">
      <p class="mono muted">finished lately</p>
      <ul>
        {finished.map((b) => <li class="row">{b.title} — {b.author}</li>)}
      </ul>
    </div>
  )}
</Card>

<style>
  .current {
    display: flex;
    gap: 24px;
  }
  .current :global(.cover) {
    flex-shrink: 0;
  }
  .stack {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }
  .author {
    font-size: 15px;
  }
  .bar {
    height: 2px;
    background: var(--kraft);
    margin-top: 16px;
  }
  .fill {
    height: 100%;
    background: var(--accent);
  }
  .finished {
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
  }
  .finished ul {
    margin-top: 8px;
  }
  .row {
    font-size: 15px;
    padding: 14px 0;
    border-top: 1px solid var(--line-soft);
  }
</style>
