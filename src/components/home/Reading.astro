---
import Card from '../Card.astro';
import Frame from '../Frame.astro';
import MediaTile from './MediaTile.astro';
import { goodreads } from '../../lib/feeds';
import { links } from '../../../site.config';
import { placeholderTone } from '../../lib/placeholder';
import { bookLabel, stars } from '../../lib/labels';
import type { CardSpan } from '../../lib/layout';

interface Props {
  span: CardSpan;
  alone: boolean;
}

const { span, alone } = Astro.props;

const book = goodreads?.currently_reading[0];
const finished = goodreads?.read.slice(0, 6) ?? [];
---

{goodreads && (
  <Card
    id="reading"
    span={span}
    alone={alone}
    label="03 — reading"
    title="on the nightstand"
    linkText="goodreads"
    href={links.goodreads}
  >
    {book && (
      <a class="current" href={book.url} aria-label={bookLabel(book.title, book.author)}>
        <Frame src={book.cover} alt="" width={120} height={180} tone={2} class="cover" />
        <span class="stack">
          <span class="mono muted">now</span>
          <span class="title">{book.title}</span>
          <span class="author muted">{book.author}</span>
        </span>
      </a>
    )}
    {finished.length > 0 && (
      <div class:list={['finished', { divided: book }]}>
        <p class="mono muted">finished lately</p>
        <ul class="tiles">
          {finished.map((b, i) => (
            <li>
              <MediaTile
                href={b.url}
                label={bookLabel(b.title, b.author)}
                image={b.cover}
                title={b.title}
                meta={stars(b.rating)}
                tone={placeholderTone(i)}
              />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Card>
)}

<style>
  .current {
    display: flex;
    gap: 24px;
  }
  .current :global(.cover) {
    flex-shrink: 0;
  }
  .stack {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }
  .current:hover .title {
    color: var(--accent);
  }
  .author {
    font-size: 15px;
  }
  .finished {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .finished.divided {
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 767px) {
    .current {
      gap: 16px;
    }
    .tiles {
      gap: 10px;
    }
  }
</style>
