---
import Card from '../Card.astro';
import { github } from '../../lib/feeds';
import { links } from '../../../site.config';
import { relativeTime } from '../../lib/dates';
import { contributionLevels } from '../../lib/contributions';

const weeks = github?.calendar.weeks.slice(-30) ?? [];
const level = contributionLevels(weeks.flatMap((w) => w.days.map((d) => d.count)));
const pushes = github?.pushes.slice(0, 3) ?? [];
---

{github && (
  <Card
    id="making"
    class="span-7"
    label="05 — making"
    title="on github"
    linkText="github"
    href={links.github}
  >
    <div
      class="calendar"
      role="img"
      aria-label={`${github.calendar.total} contributions in the last 30 weeks`}
    >
      {weeks.map((week) => (
        <div class="week">
          {week.days.map((day) => (
            <span class={`day l${level(day.count)}`} />
          ))}
        </div>
      ))}
    </div>
    <ul>
      {pushes.map((push) => (
        <li class="row">
          <span class="repo">{push.repo}</span>
          <span class="message muted">{push.message}</span>
          <span class="mono muted">{relativeTime(push.time)}</span>
        </li>
      ))}
    </ul>
  </Card>
)}

<style>
  .calendar {
    display: flex;
    gap: 4px;
  }
  .week {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .day {
    width: 14px;
    height: 14px;
    background: var(--kraft);
  }
  .day.l1 {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .day.l2 {
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .day.l3 {
    background: var(--accent);
  }
  .row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: baseline;
    column-gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
  }
  .repo,
  .message {
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
