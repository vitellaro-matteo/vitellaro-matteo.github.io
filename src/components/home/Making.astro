---
import Card from '../Card.astro';
import { github } from '../../lib/feeds';
import { links } from '../../../site.config';
import { relativeTime } from '../../lib/dates';
import { contributionLevels } from '../../lib/contributions';
import type { CardSpan } from '../../lib/layout';

interface Props {
  span: CardSpan;
  alone: boolean;
}

const { span, alone } = Astro.props;

const weeks = github?.calendar.weeks.slice(-52) ?? [];
const level = contributionLevels(weeks.flatMap((w) => w.days.map((d) => d.count)));
// Newest first: the grid lays weeks out right to left and drops the oldest that don't fit.
const newestFirst = [...weeks].reverse();
const pushes = github?.pushes.slice(0, 3) ?? [];
---

{github && (
  <Card
    id="making"
    span={span}
    alone={alone}
    label="04 — making"
    title="on github"
    linkText="github"
    href={links.github}
  >
    <div
      class="calendar"
      role="img"
      aria-label={`${github.calendar.total} contributions in the last 52 weeks`}
    >
      {newestFirst.map((week) => (
        <div class="week">
          {week.days.map((day) => (
            <span class={`day l${level(day.count)}`} />
          ))}
        </div>
      ))}
    </div>
    <ul>
      {pushes.map((push) => (
        <li class="row">
          <span class="repo">{push.repo}</span>
          <span class="message muted">{push.message}</span>
          <span class="time mono muted">{relativeTime(push.time)}</span>
        </li>
      ))}
    </ul>
  </Card>
)}

<style>
  /* One column tall (7 × 12px + 6 × 3px) with overflow hidden. Weeks run right to
     left from the newest; the ones that don't fit wrap onto a second, hidden line,
     so the card always shows whole weeks, the most recent that fit, at any width. */
  .calendar {
    height: 102px;
    overflow: hidden;
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    column-gap: 3px;
    row-gap: 102px;
  }
  .week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .day {
    width: 12px;
    height: 12px;
    background: var(--kraft);
  }
  .day.l1 {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .day.l2 {
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .day.l3 {
    background: var(--accent);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
  }
  .repo,
  .message {
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'repo time'
        'message message';
      row-gap: 2px;
    }
    .repo {
      grid-area: repo;
    }
    .time {
      grid-area: time;
    }
    .message {
      grid-area: message;
      font-size: 14px;
    }
  }
</style>
