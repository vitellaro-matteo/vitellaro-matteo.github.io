---
import Card from '../Card.astro';
import Frame from '../Frame.astro';
import MiniMap from '../map/MiniMap.astro';
import { formatDate } from '../../lib/dates';
import { getRecipes, emptyNotes } from '../../lib/content';
import { getCooked } from '../../lib/challenge';
import { COUNTRY_TOTAL } from '../../lib/countries';
import { routes } from '../../lib/paths';

const recipes = await getRecipes();
const recipe = recipes[0];
const cooked = (await getCooked()).size;
---

<Card
  id="cooking"
  class="span-12"
  label="07 — cooking"
  title="last cooked"
  linkText="all"
  href={routes.cooking}
  external={false}
>
  <div class="grid-12">
    <div class="span-5">
      {recipe ? (
        <a class="recipe" href={routes.recipe(recipe.id)}>
          <Frame src={recipe.data.image} alt={recipe.data.title} ratio="4 / 3" tone={2} />
          <span class="text">
            <span class="mono muted">
              {formatDate(recipe.data.date)} · {recipe.data.country}
            </span>
            <span class="title">{recipe.data.title}</span>
            <span class="source muted">from {recipe.data.source_name}</span>
          </span>
        </a>
      ) : (
        <p class="empty-note">{emptyNotes.cooking}</p>
      )}
    </div>
    <div class="challenge span-7">
      <MiniMap ground="card" />
      <div class="count">
        <p>
          <span class="n accent">{cooked}</span>
          <span class="of muted"> / {COUNTRY_TOTAL} national dishes</span>
        </p>
        <a class="mono" href={routes.challenge}>
          the challenge →
        </a>
      </div>
    </div>
  </div>
</Card>

<style>
  .recipe {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
  }
  .source {
    font-size: 14px;
  }
  .challenge {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .count {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .n {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
  }
  .of {
    font-size: 15px;
  }
  .count a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
</style>
