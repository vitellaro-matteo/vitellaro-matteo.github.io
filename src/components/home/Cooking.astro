---
import Card from '../Card.astro';
import Frame from '../Frame.astro';
import MiniMap from '../map/MiniMap.astro';
import { formatDate } from '../../lib/dates';
import { getRecipes, emptyNotes } from '../../lib/content';
import { getCooked } from '../../lib/challenge';
import { COUNTRY_TOTAL } from '../../lib/countries';
import { routes } from '../../lib/paths';
import type { CardSpan } from '../../lib/layout';

interface Props {
  span: CardSpan;
  alone: boolean;
}

const { span, alone } = Astro.props;

const recipes = await getRecipes();
const recipe = recipes[0];
const cooked = (await getCooked()).size;
---

<Card
  id="cooking"
  span={span}
  alone={alone}
  label="06 — cooking"
  title="last cooked"
  linkText="all"
  href={routes.cooking}
  external={false}
>
  <MiniMap ground="card" />
  <div class="latest">
    {recipe ? (
      <a class="recipe" href={routes.recipe(recipe.id)}>
        <Frame
          src={recipe.data.image}
          alt={recipe.data.title}
          width={120}
          height={90}
          tone={2}
          class="photo"
        />
        <span class="text">
          <span class="mono muted">
            {formatDate(recipe.data.date)} · {recipe.data.country}
          </span>
          <span class="title">{recipe.data.title}</span>
        </span>
      </a>
    ) : (
      <p class="empty-note">{emptyNotes.cooking}</p>
    )}
    <div class="count">
      <p>
        <span class="n accent">{cooked}</span>
        <span class="of muted"> / {COUNTRY_TOTAL} national dishes</span>
      </p>
      <a class="mono" href={routes.challenge}>
        the challenge →
      </a>
    </div>
  </div>
</Card>

<style>
  .latest {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .recipe {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .recipe :global(.photo) {
    flex-shrink: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }
  .count {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
  }
  .n {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
  }
  .of {
    font-size: 15px;
  }
  .count a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
</style>
