---
import Card from '../Card.astro';
import PreviewButton from '../PreviewButton.astro';
import { spotify } from '../../lib/feeds';
import type { CardSpan } from '../../lib/layout';

interface Props {
  span: CardSpan;
  alone: boolean;
}

const { span, alone } = Astro.props;

const tracks = spotify?.tracks.slice(0, 10) ?? [];
const hasPreviews = tracks.some((track) => track.deezer_id);
---

{spotify && (
  <Card
    id="listening"
    span={span}
    alone={alone}
    label="01 — listening"
    title="last week's finds"
    linkText="spotify"
    href={spotify.playlist_url}
  >
    <ol class="rows">
      {tracks.map((track, i) => {
        const number = String(i + 1).padStart(2, '0');
        const artists = track.artists.join(', ');
        return (
          <li class="row" data-preview-row>
            <span class="index mono muted">{number}</span>
            <span class="title">{track.title}</span>
            <span class="artist muted">{artists}</span>
            <span class="play">
              <PreviewButton
                deezerId={track.deezer_id}
                label={`Play preview of ${track.title} by ${artists}`}
              />
            </span>
            {track.deezer_id && <span class="progress" aria-hidden="true" data-preview-progress />}
          </li>
        );
      })}
    </ol>
    <div class="notes">
      {hasPreviews && (
        <p class="note muted">
          30-second previews via Deezer.{' '}
          <a class="muted" href={spotify.playlist_url}>
            Full songs on Spotify ↗
          </a>
        </p>
      )}
      <p class="note muted">
        Every Monday, the songs I liked the week before move into one playlist.
      </p>
    </div>
  </Card>
)}

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto 44px;
    align-items: baseline;
    column-gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--line-soft);
  }
  .play {
    display: flex;
    align-self: center;
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    visibility: hidden;
  }
  .playing .progress {
    visibility: visible;
  }
  .title {
    font-size: 16px;
  }
  .artist {
    font-size: 15px;
    text-align: right;
  }
  .notes {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .note {
    font-size: 14px;
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: 32px minmax(0, 1fr) 44px;
      grid-template-areas:
        'index title play'
        'index artist play';
      row-gap: 2px;
      align-items: start;
    }
    .index {
      grid-area: index;
      align-self: center;
    }
    .play {
      grid-area: play;
    }
    .title {
      grid-area: title;
      font-size: 15px;
    }
    .artist {
      grid-area: artist;
      font-size: 13px;
      text-align: left;
    }
    .row:nth-child(n + 6) {
      display: none;
    }
  }
</style>
