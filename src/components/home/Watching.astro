---
import Card from '../Card.astro';
import MediaTile from './MediaTile.astro';
import { letterboxd } from '../../lib/feeds';
import { links } from '../../../site.config';
import { placeholderTone } from '../../lib/placeholder';
import { firstSentence } from '../../lib/text';
import { filmLabel, filmMeta } from '../../lib/labels';
import type { CardSpan } from '../../lib/layout';

interface Props {
  span: CardSpan;
  alone: boolean;
}

const { span, alone } = Astro.props;

const films = letterboxd?.films.slice(0, 3) ?? [];
const latestReview = letterboxd?.films.find((f) => f.review)?.review;
const quote = latestReview ? firstSentence(latestReview) : null;
---

{letterboxd && (
  <Card
    id="watching"
    span={span}
    alone={alone}
    label="02 — watching"
    title="recently watched"
    linkText="letterboxd"
    href={links.letterboxd}
  >
    <ul class="tiles">
      {films.map((film, i) => (
        <li>
          <MediaTile
            href={film.url}
            label={filmLabel(film.title, film.year, film.rating)}
            image={film.poster}
            title={film.title}
            meta={filmMeta(film.year, film.rating)}
            tone={placeholderTone(i)}
          />
        </li>
      ))}
    </ul>
    {quote && <blockquote class="quote">“{quote}”</blockquote>}
  </Card>
)}

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .quote {
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .tiles {
      gap: 10px;
    }
  }
</style>
